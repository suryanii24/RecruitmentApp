@model IEnumerable<RecruitmentApp.Models.Biodata>

<h2>Data Pelamar</h2>

<form method="get" asp-controller="Admin" asp-action="Index" class="mb-3">
    <div class="mb-2">
        <input type="text"
               name="search"
               value="@ViewBag.Search"
               class="form-control"
               placeholder="Cari berdasarkan nama, posisi, atau pendidikan terakhir" />
    </div>

    <button type="submit" class="btn btn-primary">Cari</button>
</form>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Nama</th>
            <th>Tempat Lahir</th>
            <th>Tanggal Lahir</th>
            <th>Posisi Dilamar</th>
            <th>Aksi</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@item.Nama</td>
                    <td>@item.TempatLahir</td>
                    <td>@item.TanggalLahir.ToString("dd-MM-yyyy")</td>
                    <td>@item.PosisiDilamar</td>
                    <td>
                        <a asp-controller="Admin"
                           asp-action="Detail"
                           asp-route-id="@item.Id"
                           class="btn btn-info btn-sm">
                            Detail
                        </a>

                        <form asp-controller="Admin"
                              asp-action="Delete"
                              asp-route-id="@item.Id"
                              method="post"
                              style="display:inline;"
                              onsubmit="return confirm('Yakin ingin menghapus data ini?');">
                            <button type="submit" class="btn btn-danger btn-sm">
                                Delete
                            </button>
                        </form>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="5" class="text-center">
                    Data pelamar belum tersedia.
                </td>
            </tr>
        }
    </tbody>
</table>